// Multisig - multi-signature wallet for Astrolune.
//
// Compile:
//     trocto contracts/multisig.tc -o multisig.bin
//
// Deploy via a DEPLOY transaction with the compiled container.
// The constructor (init) receives the quorum threshold and initial owners.

contract Multisig {
    state {
        quorum: u64,
        owner_count: u64,
        owners: map<u64,address>,
        is_owner: map<address,u64>,
        tx_count: u64,
        tx_signers: map<u64,u64>,
        tx_executed: map<u64,u64>,
    }

    init(quorum: u64) {
        require(quorum > 0, 10);
        self.quorum = quorum;
        self.owner_count = 1;
        owners[1] = sender();
        is_owner[sender()] = 1;
    }

    pub fn add_owner(owner: address) -> u64 {
        require(is_owner[sender()] == 1, 1);
        require(is_owner[owner] == 0, 11);
        self.owner_count += 1;
        owners[self.owner_count] = owner;
        is_owner[owner] = 1;
        emit OwnerAdded(owner);
        return 1;
    }

    pub fn submit_tx() -> u64 {
        require(is_owner[sender()] == 1, 1);
        self.tx_count += 1;
        tx_signers[self.tx_count] = 1;
        tx_executed[self.tx_count] = 0;
        emit TxSubmitted(self.tx_count, sender());
        return self.tx_count;
    }

    pub fn sign_tx(tx_id: u64) -> u64 {
        require(is_owner[sender()] == 1, 1);
        require(tx_executed[tx_id] == 0, 12);
        tx_signers[tx_id] += 1;
        emit TxSigned(tx_id, sender());
        return tx_signers[tx_id];
    }

    pub fn execute_tx(tx_id: u64) -> u64 {
        require(tx_executed[tx_id] == 0, 12);
        require(tx_signers[tx_id] >= self.quorum, 13);
        tx_executed[tx_id] = 1;
        emit TxExecuted(tx_id);
        return 1;
    }

    pub fn tx_signer_count(tx_id: u64) -> u64 {
        return tx_signers[tx_id];
    }

    pub fn is_executed(tx_id: u64) -> u64 {
        return tx_executed[tx_id];
    }

    pub fn quorum() -> u64 {
        return self.quorum;
    }

    pub fn owner_count() -> u64 {
        return self.owner_count;
    }
}
