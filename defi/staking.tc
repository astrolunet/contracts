//
// Staking - token staking with reward accumulation for Astrolune.
//
// Compile:
//     trocto contracts/defi/staking.tc -o staking.bin
//
// Deploy via a DEPLOY transaction with the compiled container.
// Users stake tokens and earn rewards based on staking duration and amount.

contract Staking {
    state {
        reward_rate: u64,
        total_staked: u64,
        stakes: map<address,u64>,
        stake_time: map<address,u64>,
        reward_per_token_stored: u64,
        last_update: u64,
        user_reward_per_token_paid: map<address,u64>,
        rewards: map<address,u64>,
    }

    init(reward_rate: u64) {
        self.reward_rate = reward_rate;
        self.last_update = block_height();
    }

    fn update_reward(account: address) {
        self.reward_per_token_stored = self.reward_per_token();
        self.last_update = block_height();
        if (account != 0) {
            rewards[account] = self.earned(account);
            user_reward_per_token_paid[account] = self.reward_per_token_stored;
        }
    }

    fn reward_per_token() -> u64 {
        if (self.total_staked == 0) {
            return self.reward_per_token_stored;
        }
        return self.reward_per_token_stored + ((block_height() - self.last_update) * self.reward_rate * 100) / self.total_staked;
    }

    fn earned(account: address) -> u64 {
        return (stakes[account] * (self.reward_per_token() - user_reward_per_token_paid[account])) / 100 + rewards[account];
    }

    pub fn stake(amount: u64) -> u64 {
        require(amount > 0, 20);
        self.update_reward(sender());
        stakes[sender()] += amount;
        self.total_staked += amount;
        emit Staked(sender(), amount);
        return stakes[sender()];
    }

    pub fn unstake(amount: u64) -> u64 {
        require(stakes[sender()] >= amount, 2);
        require(amount > 0, 4);
        self.update_reward(sender());
        stakes[sender()] -= amount;
        self.total_staked -= amount;
        emit Unstaked(sender(), amount);
        return stakes[sender()];
    }

    pub fn claim_reward() -> u64 {
        self.update_reward(sender());
        let reward = rewards[sender()];
        rewards[sender()] = 0;
        emit RewardClaimed(sender(), reward);
        return reward;
    }

    pub fn earned(account: address) -> u64 {
        return self.earned(account);
    }

    pub fn balance_of(user: address) -> u64 {
        return stakes[user];
    }

    pub fn total_staked() -> u64 {
        return self.total_staked;
    }

    pub fn reward_rate() -> u64 {
        return self.reward_rate;
    }
}
