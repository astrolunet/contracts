//
// Governance Token - voting-weight token for Astrolune governance.
//
// Compile:
//     trocto contracts/token/governance_token.tc -o governance_token.bin
//
// Deploy via a DEPLOY transaction with the compiled container.
// Token holders accumulate voting power equal to their balance.
// Voting power is snapshot at proposal creation block.

contract GovernanceToken {
    state {
        name: u64,
        symbol: u64,
        total_supply: u64,
        balances: map<address,u64>,
        allowances: map<address,u64>,
        checkpoints: map<address,u64>,
        checkpoints_block: map<address,u64>,
    }

    init(name: u64, symbol: u64, initial_supply: u64) {
        self.name = name;
        self.symbol = symbol;
        self.total_supply = initial_supply;
        balances[sender()] = initial_supply;
        checkpoints[sender()] = initial_supply;
        checkpoints_block[sender()] = block_height();
        emit Transfer(0, sender(), initial_supply);
    }

    pub fn total_supply() -> u64 {
        return self.total_supply;
    }

    pub fn balance_of(owner: address) -> u64 {
        return balances[owner];
    }

    pub fn voting_power_at(owner: address, block_num: u64) -> u64 {
        if (block_num >= checkpoints_block[owner]) {
            return checkpoints[owner];
        }
        return 0;
    }

    pub fn current_voting_power(owner: address) -> u64 {
        return checkpoints[owner];
    }

    pub fn transfer(to: address, amount: u64) -> u64 {
        let sender_balance = balances[sender()];
        require(sender_balance >= amount, 2);
        require(amount > 0, 4);
        balances[sender()] = sender_balance - amount;
        balances[to] += amount;
        checkpoints[sender()] = balances[sender()];
        checkpoints_block[sender()] = block_height();
        checkpoints[to] = balances[to];
        checkpoints_block[to] = block_height();
        emit Transfer(sender(), to, amount);
        return 1;
    }

    pub fn approve(spender: address, amount: u64) -> u64 {
        allowances[sender()] = amount;
        emit Approval(sender(), spender, amount);
        return 1;
    }

    pub fn transfer_from(from: address, to: address, amount: u64) -> u64 {
        let allowed = allowances[from];
        require(allowed >= amount, 3);
        let from_balance = balances[from];
        require(from_balance >= amount, 2);
        allowances[from] = allowed - amount;
        balances[from] = from_balance - amount;
        balances[to] += amount;
        checkpoints[from] = balances[from];
        checkpoints_block[from] = block_height();
        checkpoints[to] = balances[to];
        checkpoints_block[to] = block_height();
        emit Transfer(from, to, amount);
        return 1;
    }

    pub fn burn(amount: u64) -> u64 {
        let sender_balance = balances[sender()];
        require(sender_balance >= amount, 2);
        balances[sender()] = sender_balance - amount;
        self.total_supply -= amount;
        checkpoints[sender()] = balances[sender()];
        checkpoints_block[sender()] = block_height();
        emit Transfer(sender(), 0, amount);
        return 1;
    }

    pub fn delegate(delegatee: address) -> u64 {
        let power = balances[sender()];
        checkpoints[delegatee] += power;
        checkpoints_block[delegatee] = block_height();
        emit Delegated(sender(), delegatee, power);
        return 1;
    }
}
